# SMTP (для Gmail нужен «пароль приложения»:
# Google Аккаунт → Безопасность → Двухэтапная аутентификация → Пароли приложений)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# От кого и кому приходят заявки (по умолчанию — SMTP_USER)
# SMTP_FROM=your-email@gmail.com
CONTACT_EMAIL=Yurii_golovko@gmail.com
# CONTACT_EMAIL=zayavki@example.com

# Порт HTTP-сервера
PORT=4000

# Разрешённые origin'ы для CORS, через запятую.
# По умолчанию: федерацияии.рф (punycode), www, pouswho.github.io и localhost:3000
# ALLOWED_ORIGINS=https://xn--80ahcbqaa4d6aza4h.xn--p1ai,http://localhost:3000

# Максимум заявок с одного IP за 10 минут
RATE_LIMIT=5

# Включить, если бекенд стоит за nginx/прокси (иначе rate-limit видит IP прокси)
TRUST_PROXY=false

# Подключение к PostgreSQL (новости). Пользователь/пароль/база должны совпадать
# с POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB сервиса postgres в docker-compose.
DATABASE_URL=postgres://fii_news:changeme@localhost:5432/fii_news

# Используются сервисом postgres в docker-compose для инициализации базы —
# должны соответствовать значениям, зашитым в DATABASE_URL выше.
POSTGRES_USER=fii_news
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fii_news

# Секретный токен для закрытых эндпоинтов /api/news (POST/PATCH/DELETE) и
# /api/admin/news. Никогда не передавать во frontend JavaScript — только
# для серверных систем (Telegram-бот, автоматизация).
NEWS_API_TOKEN=change-me-to-a-long-random-secret

# Мягкий лимит публичных GET /api/news* запросов с одного IP в минуту
NEWS_READ_RATE_LIMIT=120

# Лимит POST/PATCH/DELETE /api/news с одного IP за 10 минут
NEWS_WRITE_RATE_LIMIT=30
