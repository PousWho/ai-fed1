# SMTP (для Gmail нужен «пароль приложения»:
# Google Аккаунт → Безопасность → Двухэтапная аутентификация → Пароли приложений)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# От кого и кому приходят заявки (по умолчанию — SMTP_USER)
# SMTP_FROM=your-email@gmail.com
CONTACT_EMAIL=Yurii_golovko@gmail.com
# CONTACT_EMAIL=zayavki@example.com

# Порт HTTP-сервера
PORT=4000

# Разрешённые origin'ы для CORS, через запятую.
# По умолчанию: федерацияии.рф (punycode), www, pouswho.github.io и localhost:3000
# ALLOWED_ORIGINS=https://xn--80ahcbqaa4d6aza4h.xn--p1ai,http://localhost:3000

# Максимум заявок с одного IP за 10 минут
RATE_LIMIT=5

# Включить, если бекенд стоит за nginx/прокси (иначе rate-limit видит IP прокси)
TRUST_PROXY=false
